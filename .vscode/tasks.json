{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译当前文件 (gcc)",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-g",
        "-Wall",
        "*.c",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "编译当前文件 (g++)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "-Wall",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "编译并运行当前文件",
      "type": "shell",
      "command": "gcc -g -Wall \"${fileDirname}\"/*.c -o \"${fileDirname}/hello_app\" && \"${fileDirname}/hello_app\"",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "type": "cppbuild",
      "label": "C/C++: gcc 生成活动文件",
      "command": "/usr/bin/gcc",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${fileDirname}/*.c",
        "-o",
        "${fileDirname}/hello_app"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "调试器生成的任务。"
    }
  ]
}